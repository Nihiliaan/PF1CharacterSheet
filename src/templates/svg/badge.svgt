<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 250" width="540" height="250" style="background: transparent; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;">
  <defs>
    <linearGradient id="bg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="hp-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ef4444" />
      <stop offset="100%" stop-color="#f87171" />
    </linearGradient>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.35" />
    </filter>
    <clipPath id="avatar-clip">
      <rect x="20" y="20" width="76" height="76" rx="10" />
    </clipPath>
  </defs>

  <!-- Card Background -->
  <rect x="4" y="4" width="532" height="242" rx="14" fill="url(#bg-grad)" stroke="#334155" stroke-width="1.5" filter="url(#shadow)" />

  <!-- Avatar or Placeholder -->
  {{#if basic.avatars.url.[0]}}
  <image href="{{basic.avatars.url.[0]}}" x="20" y="20" width="76" height="76" preserveAspectRatio="xMidYMid slice" clip-path="url(#avatar-clip)" />
  <rect x="20" y="20" width="76" height="76" rx="10" fill="none" stroke="#64748b" stroke-width="1.5" />
  {{else}}
  <rect x="20" y="20" width="76" height="76" rx="10" fill="#334155" stroke="#475569" stroke-width="1.5" />
  <text x="58" y="66" text-anchor="middle" font-size="32" fill="#94a3b8">👤</text>
  {{/if}}

  <!-- Header Info -->
  <text x="110" y="44" font-size="20" font-weight="bold" fill="#f8fafc">{{xmlEscape (default name '未命名角色')}}</text>
  <text x="110" y="66" font-size="12" fill="#94a3b8">
    {{xmlEscape (default basic.alignment '中立')}} · {{xmlEscape (default basic.race '人类')}} · {{xmlEscape (default basic.classes '冒险者 1')}}
  </text>
  <text x="110" y="86" font-size="11" fill="#64748b">
    先攻 {{signed defenses.initiative.total}} · 速度 {{default speed.base '30'}}尺 · 感知 {{xmlEscape (default basic.senses '普通')}}
  </text>

  <!-- Tag: PF1 -->
  <rect x="466" y="20" width="54" height="20" rx="4" fill="#3b82f6" fill-opacity="0.2" stroke="#3b82f6" stroke-width="1" />
  <text x="493" y="34" font-size="10" font-weight="bold" fill="#60a5fa" text-anchor="middle">PF 1E</text>

  <!-- Combat Badges Row (HP, AC, Saves) -->
  <!-- HP Badge -->
  <g transform="translate(20, 108)">
    <rect x="0" y="0" width="96" height="38" rx="6" fill="#1e1e24" stroke="#dc2626" stroke-width="1" />
    <text x="8" y="16" font-size="9" font-weight="bold" fill="#f87171">生命值 (HP)</text>
    <text x="8" y="32" font-size="15" font-weight="bold" fill="#ffffff">{{default defenses.hp.current '—'}} <tspan font-size="10" fill="#94a3b8">/ {{default defenses.hp.total '—'}}</tspan></text>
  </g>

  <!-- AC Badge -->
  <g transform="translate(124, 108)">
    <rect x="0" y="0" width="130" height="38" rx="6" fill="#1e293b" stroke="#3b82f6" stroke-width="1" />
    <text x="8" y="16" font-size="9" font-weight="bold" fill="#60a5fa">防御等级 (AC)</text>
    <text x="8" y="32" font-size="15" font-weight="bold" fill="#ffffff">{{default defenses.ac.total '10'}} <tspan font-size="9" fill="#94a3b8">触{{default defenses.ac.touch '10'}} 措{{default defenses.ac.flatFooted '10'}}</tspan></text>
  </g>

  <!-- Saves Badge -->
  <g transform="translate(262, 108)">
    <rect x="0" y="0" width="144" height="38" rx="6" fill="#1e293b" stroke="#10b981" stroke-width="1" />
    <text x="8" y="16" font-size="9" font-weight="bold" fill="#34d399">豁免 (强/反/意)</text>
    <text x="8" y="32" font-size="13" font-weight="bold" fill="#ffffff">
      {{signed defenses.fortitude.total}} / {{signed defenses.reflex.total}} / {{signed defenses.will.total}}
    </text>
  </g>

  <!-- CMD / CMB Badge -->
  <g transform="translate(414, 108)">
    <rect x="0" y="0" width="106" height="38" rx="6" fill="#1e293b" stroke="#f59e0b" stroke-width="1" />
    <text x="8" y="16" font-size="9" font-weight="bold" fill="#fbbf24">战头 (BAB/CMD)</text>
    <text x="8" y="32" font-size="13" font-weight="bold" fill="#ffffff">
      {{signed attacks.bab.total}} / {{default defenses.cmd.total '10'}}
    </text>
  </g>

  <!-- Attributes Chips Row -->
  <g transform="translate(20, 156)">
    <!-- STR -->
    <rect x="0" y="0" width="80" height="34" rx="5" fill="#0f172a" stroke="#334155" />
    <text x="8" y="14" font-size="9" fill="#94a3b8">力量 STR</text>
    <text x="8" y="28" font-size="12" font-weight="bold" fill="#f8fafc">{{default attributes.total.[0] '10'}} <tspan font-size="10" fill="#38bdf8">({{attrMod attributes.total.[0]}})</tspan></text>

    <!-- DEX -->
    <rect x="84" y="0" width="80" height="34" rx="5" fill="#0f172a" stroke="#334155" />
    <text x="92" y="14" font-size="9" fill="#94a3b8">敏捷 DEX</text>
    <text x="92" y="28" font-size="12" font-weight="bold" fill="#f8fafc">{{default attributes.total.[1] '10'}} <tspan font-size="10" fill="#38bdf8">({{attrMod attributes.total.[1]}})</tspan></text>

    <!-- CON -->
    <rect x="168" y="0" width="80" height="34" rx="5" fill="#0f172a" stroke="#334155" />
    <text x="176" y="14" font-size="9" fill="#94a3b8">体质 CON</text>
    <text x="176" y="28" font-size="12" font-weight="bold" fill="#f8fafc">{{default attributes.total.[2] '10'}} <tspan font-size="10" fill="#38bdf8">({{attrMod attributes.total.[2]}})</tspan></text>

    <!-- INT -->
    <rect x="252" y="0" width="80" height="34" rx="5" fill="#0f172a" stroke="#334155" />
    <text x="260" y="14" font-size="9" fill="#94a3b8">智力 INT</text>
    <text x="260" y="28" font-size="12" font-weight="bold" fill="#f8fafc">{{default attributes.total.[3] '10'}} <tspan font-size="10" fill="#38bdf8">({{attrMod attributes.total.[3]}})</tspan></text>

    <!-- WIS -->
    <rect x="336" y="0" width="80" height="34" rx="5" fill="#0f172a" stroke="#334155" />
    <text x="344" y="14" font-size="9" fill="#94a3b8">感知 WIS</text>
    <text x="344" y="28" font-size="12" font-weight="bold" fill="#f8fafc">{{default attributes.total.[4] '10'}} <tspan font-size="10" fill="#38bdf8">({{attrMod attributes.total.[4]}})</tspan></text>

    <!-- CHA -->
    <rect x="420" y="0" width="80" height="34" rx="5" fill="#0f172a" stroke="#334155" />
    <text x="428" y="14" font-size="9" fill="#94a3b8">魅力 CHA</text>
    <text x="428" y="28" font-size="12" font-weight="bold" fill="#f8fafc">{{default attributes.total.[5] '10'}} <tspan font-size="10" fill="#38bdf8">({{attrMod attributes.total.[5]}})</tspan></text>
  </g>

  <!-- Weapons / Primary Action Line -->
  <g transform="translate(20, 202)">
    <rect x="0" y="0" width="500" height="26" rx="4" fill="#0f172a" stroke="#1e293b" />
    <text x="8" y="17" font-size="10" font-weight="bold" fill="#e2e8f0">
      ⚔️ {{#if attacks.weapon.name.[0]}}{{xmlEscape attacks.weapon.name.[0]}} (加值: {{signed attacks.weapon.attackBonus.[0]}}, 伤害: {{xmlEscape attacks.weapon.damage.[0]}}){{else}}徒手打击 (加值: +0, 伤害: 1d3){{/if}}
      {{#if attacks.weapon.name.[1]}} | {{xmlEscape attacks.weapon.name.[1]}} (加值: {{signed attacks.weapon.attackBonus.[1]}}, 伤害: {{xmlEscape attacks.weapon.damage.[1]}}){{/if}}
    </text>
  </g>

  <!-- Footer Link/Note -->
  <text x="520" y="238" font-size="9" fill="#475569" text-anchor="end">PF1CharacterSheet · 纯美苹果园</text>
</svg>